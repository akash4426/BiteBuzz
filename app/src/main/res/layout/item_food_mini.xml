<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/miniFoodCard"
    android:layout_width="188dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:rippleColor="@color/primary_soft">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="7dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/miniFoodImage"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.BiteBuzz.RoundedMedium"
            tools:src="@drawable/img_paneer_wrap" />

        <TextView
            android:id="@+id/miniFoodName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="5dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_semibold"
            android:lines="2"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            tools:text="Spicy Paneer Wrap" />

        <TextView
            android:id="@+id/miniFoodRestaurant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_regular"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="9.5sp"
            tools:text="Wrap It Up" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_star" />

            <TextView
                android:id="@+id/miniFoodRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                tools:text="4.4" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/miniFoodPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                tools:text="₹149" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/miniAddButton"
            style="@style/Widget.BiteBuzz.Button.Add"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="5dp"
            android:contentDescription="@string/add_to_cart"
            android:text="@string/add" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

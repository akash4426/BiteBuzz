<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-90dp"
        android:layout_marginEnd="-80dp"
        android:alpha="0.10"
        android:background="@drawable/bg_circle_white" />

    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-70dp"
        android:layout_marginBottom="-60dp"
        android:alpha="0.08"
        android:background="@drawable/bg_circle_white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="138dp"
            android:layout_height="138dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo_mark" />

        <LinearLayout
            android:id="@+id/splashBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:letterSpacing="-0.03"
                android:text="@string/brand_bite"
                android:textColor="@color/white"
                android:textSize="42sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:letterSpacing="-0.03"
                android:text="@string/brand_buzz"
                android:textColor="@color/accent"
                android:textSize="42sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:letterSpacing="0.01"
            android:maxWidth="280dp"
            android:text="@string/tagline"
            android:textColor="@color/white_80"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/splashBee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/emoji_bee"
            android:textSize="28sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/splashLoadingGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="42dp"
        android:gravity="center"
        android:orientation="vertical">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:layout_width="64dp"
            android:layout_height="4dp"
            app:indicatorColor="@color/accent"
            app:trackColor="@color/white_15"
            app:trackCornerRadius="4dp"
            app:trackThickness="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/poppins_regular"
            android:letterSpacing="0.04"
            android:text="@string/splash_loading"
            android:textColor="@color/white_60"
            android:textSize="9.5sp" />
    </LinearLayout>
</FrameLayout>

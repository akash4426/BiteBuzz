<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="34dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/stepCircle"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_step_todo">

            <ImageView
                android:id="@+id/stepIcon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/stepNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/text_hint"
                android:textSize="11sp"
                tools:text="1" />
        </FrameLayout>

        <View
            android:id="@+id/stepLine"
            android:layout_width="2dp"
            android:layout_height="42dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_track_line_idle" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="22dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stepTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/text_hint"
            android:textSize="13.5sp"
            tools:text="Order Confirmed" />

        <TextView
            android:id="@+id/stepDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/text_hint"
            android:textSize="10.5sp"
            tools:text="We've received your order" />
    </LinearLayout>
</LinearLayout>
